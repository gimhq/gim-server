# HTTP listen port and address.
PORT=8080
HOST=0.0.0.0

# SQLite database file. Use ":memory:" for an ephemeral database.
DATABASE_PATH=./data/gim.db

# Root data directory. Encrypted blobs are stored in $DATA_DIR/blobs.
DATA_DIR=./data

# Events older than this many days are pruned; clients behind the pruned
# cursor receive 410 cursor_expired and must resync.
EVENT_RETENTION_DAYS=7

# A keypackages.low event is emitted when a device's one-time key package
# count drops below this value.
KEYPACKAGE_LOW_THRESHOLD=10

# Maximum decoded size (bytes) of a message payload.
MAX_MESSAGE_BYTES=262144

# Maximum size (bytes) of an uploaded blob.
MAX_BLOB_BYTES=104857600

# Upper bound for the `wait` parameter of GET /v1/events (long polling).
LONGPOLL_MAX_WAIT_SECONDS=30

# debug | info | warn | error
LOG_LEVEL=info
